// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Users {
  id                  String          @id @default(uuid())
  email               String?         @db.VarChar(100)
  password            String
  full_name           String
  phone               String?         @db.VarChar(20)
  birthday            DateTime?
  gender              Gender?
  role                Role
  verification        Vertifications?
  avatar_url          String?
  code_reset_password String?         @db.VarChar(6)
  refresh_token       String?         @db.VarChar(255)
  is_disable          Boolean         @default(false)
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  unaccent            String?         @db.Text
  type_email          TypeEmail       @default(NORMAL)
  type_user           TypeUser        @default(SYSTEM_CUSTOMER)
  Addresses           Address[]
  Orders              Orders[]
  Carts               Carts?
  Reviews             Reviews[]
  Groups              Groups[]
  OrderItems          OrderItems[]
  GroupMembers        GroupMembers[]
  Payments            Payments[]
  NewAddress          NewAddress[]

  @@unique([email, type_email])
  @@index([full_name, email, phone, type_email], map: "users_fulltext_idx")
}

model Vertifications {
  id            Int     @id @default(autoincrement())
  user_id       String  @unique
  user          Users   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  verified_code String
  is_active     Boolean @default(false)
}

model Books {
  id                             String                           @id @default(uuid())
  title                          String                           @db.VarChar(255)
  author                         String?
  category_id                    String
  price                          Decimal
  stock_quantity                 Int
  description                    String                           @db.Text
  entry_price                    Decimal
  final_price                    Decimal?
  current_price                  Decimal?
  discountPercentage             Int?
  discountDate                   DateTime?
  avg_stars                      Decimal                          @default(0)
  total_reviews                  Int                              @default(0)
  sold_quantity                  Int                              @default(0)
  image_url                      String[]                         @default([])
  status                         BookStatus                       @default(ACTIVE)
  created_at                     DateTime                         @default(now())
  updated_at                     DateTime                         @updatedAt
  unaccent                       String?                          @db.Text
  supplier_id                    String?
  sku                            String?                          @unique
  Supplier                       Supplier?                        @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  Category                       Category                         @relation(fields: [category_id], references: [id], onDelete: Cascade)
  OrderItems                     OrderItems[]
  CartItems                      CartItems[]
  Reviews                        Reviews[]
  BookAuthor                     BookAuthor[]
  InventoryFormItem              InventoryFormItem[]
  AdjustStockFormItem            AdjustStockFormItem[]
  PromotionShockDealCondition    PromotionShockDealCondition[]
  PromotionNormalDetail          PromotionNormalDetail[]
  PromotionComboProduct          PromotionComboProduct[]
  PromotionShockDealBook         PromotionShockDealBook[]
  PromotionShockDealFreeGiftBook PromotionShockDealFreeGiftBook[]
  GroupItems                     GroupItems[]

  @@index([title, author], map: "books_fulltext_idx")
}

model Category {
  id         String  @id @default(uuid())
  name       String  @unique
  is_disable Boolean @default(false)
  books      Books[]
  unaccent   String? @db.Text

  @@index([name])
}

model Authors {
  id          String       @id @default(uuid())
  name        String       @db.VarChar(255)
  birthday    DateTime
  description String
  avatar_url  String
  unaccent    String?      @db.Text
  BookAuthor  BookAuthor[]

  @@unique([name, birthday, description])
  @@index([name, description], map: "authors_fulltext_idx")
}

model BookAuthor {
  id        String  @id @default(uuid())
  book_id   String
  author_id String
  book      Books   @relation(fields: [book_id], references: [id])
  author    Authors @relation(fields: [author_id], references: [id])

  @@unique([book_id, author_id])
}

model Orders {
  id             String        @id @default(uuid())
  user_id        String
  user           Users         @relation(fields: [user_id], references: [id])
  status         OrderStatus   @default(PENDING)
  review_state   ReviewState   @default(UNREVIEW)
  total_price    Decimal       @default(0)
  full_name      String
  phone_number   String
  address        String
  pending_at     DateTime
  processing_at  DateTime?
  delivered_at   DateTime?
  cancelled_at   DateTime?
  success_at     DateTime?
  reject_at      DateTime?
  note           String?       @db.Text
  is_paid        Boolean       @default(false)
  payment_url    String?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  payment_method PaymentMethod @default(COD)
  is_deleted     Boolean       @default(false)
  OrderItems     OrderItems[]
  Payments       Payments[]

  @@index([full_name, phone_number, address], map: "orders_fulltext_idx")
}

model OrderItems {
  id            String      @id @default(uuid())
  order_id      String
  order         Orders      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  book_id       String
  book          Books       @relation(fields: [book_id], references: [id], onDelete: Cascade)
  review_status ReviewState @default(UNREVIEW)
  review_id     Int?
  review        Reviews?
  promotion_ids String[]    @default([])
  group_user_id String?
  GroupUser     Users?      @relation(fields: [group_user_id], references: [id], onDelete: Cascade)
  quantity      Int
  price         Decimal
  total_price   Decimal
}

model Carts {
  id         Int         @id @default(autoincrement())
  user_id    String      @unique()
  user       Users       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at DateTime    @default(now())
  CartItems  CartItems[]
}

model CartItems {
  id         Int      @id @default(autoincrement())
  cart_id    Int
  cart       Carts    @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  book_id    String
  book       Books    @relation(fields: [book_id], references: [id])
  quantity   Int
  created_at DateTime @default(now())
}

model Reviews {
  id              Int           @id @default(autoincrement())
  user_id         String
  user            Users         @relation(fields: [user_id], references: [id])
  book_id         String
  book            Books         @relation(fields: [book_id], references: [id])
  title           String
  rating          Decimal
  is_hidden       Boolean       @default(false)
  description     String
  state           ReviewState   @default(UNREVIEW)
  type            ReviewType
  reply_review_id Int?
  created_at      DateTime      @default(now())
  ReplyReviews    ReplyReviews?
  order_item_id   String        @unique
  OrderItem       OrderItems    @relation(fields: [order_item_id], references: [id])

  @@index([title, description], map: "reviews_fulltext_idx")
}

model ReplyReviews {
  id         Int      @id @default(autoincrement())
  review_id  Int      @unique
  review     Reviews  @relation(fields: [review_id], references: [id])
  reply      String
  created_at DateTime @default(now())
}

model Address {
  id           Int     @id @default(autoincrement())
  user_id      String
  full_name    String
  phone_number String
  address      String
  unaccent     String? @db.Text
  Users        Users?  @relation(fields: [user_id], references: [id])

  @@index([full_name, address, phone_number], map: "address_fulltext_idx")
}

model Supplier {
  id       String  @id @default(uuid())
  name     String  @unique
  phone    String
  email    String
  address  String
  active   Boolean @default(true)
  unaccent String? @db.Text
  Books    Books[]

  @@index([name, email, phone])
}

model InventoryForm {
  id                String              @id @default(uuid())
  type              InventoryFormType
  state             InventoryFormState  @default(PENDING)
  note              String?
  expected_date     DateTime
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  InventoryFormItem InventoryFormItem[]
}

model InventoryFormItem {
  id                String        @id @default(uuid())
  inventory_form_id String
  inventory_form    InventoryForm @relation(fields: [inventory_form_id], references: [id])
  sku               String
  book_id           String
  book              Books         @relation(fields: [book_id], references: [id])
  expected_quantity Int
  entry_price       Decimal
  quantity          Int
  selling_price     Decimal
}

model AdjustStockForm {
  id                  String                @id @default(uuid())
  type                InventoryType
  state               InventoryFormState    @default(PENDING)
  note                String?
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt
  AdjustStockFormItem AdjustStockFormItem[]
}

model AdjustStockFormItem {
  id                   String          @id @default(uuid())
  adjust_stock_form_id String
  adjust_stock_form    AdjustStockForm @relation(fields: [adjust_stock_form_id], references: [id])
  sku                  String
  book_id              String?
  book                 Books?          @relation(fields: [book_id], references: [id])
  quantity             Int
}

model InventoryAddress {
  id      String        @id @default(uuid())
  name    String
  address String
  note    String?
  type    InventoryType
}

model Promotion {
  id                    String                  @id @default(uuid())
  name                  String
  start_date            DateTime
  end_date              DateTime
  order_limit           Int?
  max_usage_per_user    Int?
  status                PromotionStatus
  promotion_category    PromotionCategory
  is_active             Boolean                 @default(true)
  created_at            DateTime                @default(now())
  updated_at            DateTime?               @updatedAt
  PromotionNormalDetail PromotionNormalDetail[]
  PromotionCombo        PromotionCombo?
  PromotionShockDeal    PromotionShockDeal?
}

model PromotionNormalDetail {
  id              String    @id @default(uuid())
  promotion_id    String
  Promotion       Promotion @relation(fields: [promotion_id], references: [id])
  book_id         String
  Book            Books     @relation(fields: [book_id], references: [id])
  discount_amount Decimal
  discount_rate   Decimal
}

model PromotionCombo {
  id                      String                    @id @default(uuid())
  promotion_id            String                    @unique
  Promotion               Promotion                 @relation(fields: [promotion_id], references: [id])
  promotion_combo_type    PromotionComboType
  PromotionComboCondition PromotionComboCondition[]
  PromotionComboProduct   PromotionComboProduct[]
}

model PromotionComboProduct {
  id                 String          @id @default(uuid())
  promotion_combo_id String
  PromotionCombo     PromotionCombo? @relation(fields: [promotion_combo_id], references: [id])
  book_id            String
  Book               Books           @relation(fields: [book_id], references: [id])
}

model PromotionComboCondition {
  id                 String         @id @default(uuid())
  promotion_combo_id String
  PromotionCombo     PromotionCombo @relation(fields: [promotion_combo_id], references: [id])
  quantity           Int
  discount_value     Decimal
}

model PromotionShockDeal {
  id                             String                           @id @default(uuid())
  promotion_id                   String                           @unique
  Promotion                      Promotion                        @relation(fields: [promotion_id], references: [id])
  promotion_shock_deal_type      PromotionShockDealType
  required_purchase_quantity     Int?
  gift_quantity                  Int?
  PromotionShockDealBook         PromotionShockDealBook[]
  PromotionShockDealFreeGiftBook PromotionShockDealFreeGiftBook[]
  PromotionShockDealCondition    PromotionShockDealCondition[]
}

model PromotionShockDealBook {
  id                      String             @id @default(uuid())
  PromotionShockDeal      PromotionShockDeal @relation(fields: [promotion_shock_deal_id], references: [id])
  promotion_shock_deal_id String
  book_id                 String
  Book                    Books              @relation(fields: [book_id], references: [id])
}

model PromotionShockDealCondition {
  id                      String             @id @default(uuid())
  promotion_shock_deal_id String
  PromotionShockDeal      PromotionShockDeal @relation(fields: [promotion_shock_deal_id], references: [id])
  discount_rate           Int
  discount_amount         Decimal
  book_id                 String
  Book                    Books              @relation(fields: [book_id], references: [id])
}

model PromotionShockDealFreeGiftBook {
  id                      String             @id @default(uuid())
  promotion_shock_deal_id String
  PromotionShockDeal      PromotionShockDeal @relation(fields: [promotion_shock_deal_id], references: [id])
  book_id                 String
  Book                    Books              @relation(fields: [book_id], references: [id])
}

model Groups {
  id           String         @id @default(uuid())
  host_id      String
  User         Users          @relation(fields: [host_id], references: [id])
  group_status GroupStatus    @default(ACTIVE)
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt
  GroupMembers GroupMembers[]
}

model GroupMembers {
  id         String       @id @default(uuid())
  group_id   String
  Group      Groups       @relation(fields: [group_id], references: [id])
  user_id    String
  User       Users        @relation(fields: [user_id], references: [id])
  GroupItems GroupItems[]
}

model GroupItems {
  id              String       @id @default(uuid())
  group_member_id String
  GroupMember     GroupMembers @relation(fields: [group_member_id], references: [id])
  book_id         String
  Book            Books        @relation(fields: [book_id], references: [id])
  quantity        Int
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@unique([group_member_id, book_id])
}

model NewAddress {
  id           String    @id @default(uuid())
  user_id      String
  User         Users     @relation(fields: [user_id], references: [id])
  full_name    String
  phone_number String
  street       String
  ward_name    String?
  district_id  String
  District     Districts @relation(fields: [district_id], references: [id])
  lat          Decimal
  lon          Decimal
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
}

model Payments {
  id         String        @id @default(uuid())
  order_id   String
  Order      Orders        @relation(fields: [order_id], references: [id])
  user_id    String
  User       Users         @relation(fields: [user_id], references: [id])
  amount     Float
  method     PaymentMethod
  status     PaymentStatus
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt
}

model Districts {
  id            String       @id @default(uuid())
  name          String
  city_id       String
  City          Cities       @relation(fields: [city_id], references: [id])
  district_code String
  NewAddress    NewAddress[]
}

model Vouchers {
  id   String @id @default(uuid())
  code String @unique
  name String
}

model Cities {
  id          String      @id @default(uuid())
  name        String
  Districts   Districts[]
  postal_code String
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum OrderStatus {
  PENDING
  PROCESSING
  DELIVERED
  CANCELLED
  SUCCESS
  REJECT
}

enum BookStatus {
  INACTIVE
  ACTIVE
}

enum ReviewState {
  UNREVIEW
  REVIEWED
  REPLIED
}

enum PaymentMethod {
  COD
  MOMO
  ZALOPAY
  VNPAY
}

enum ReviewType {
  POSITIVE
  NEGATIVE
  CONSTRUCTIVE
  SPAM
  TOXIC
}

enum TypeEmail {
  NORMAL
  GOOGLE
}

enum TypeUser {
  POTENTIAL_CUSTOMER
  SYSTEM_CUSTOMER
}

enum InventoryType {
  NORMAL
  DEFECTIVE
}

enum InventoryFormType {
  PURCHASE
  RESTOCK
}

enum InventoryFormState {
  PENDING
  DONE
  CANCELLED
}

enum PromotionCategory {
  SHOP_DISCOUNT
  COMBO_DISCOUNT
  DEAL_DISCOUNT
}

enum DiscountType {
  PERCENTAGE
  FIXED
  SPECIAL
}

enum PromotionStatus {
  UPCOMING
  ONGOING
  COMPLETED
}

enum PromotionComboType {
  PERCENTAGE
  FIXED_AMOUNT
  SPECIAL_DISCOUNT
}

enum PromotionShockDealType {
  BUY_WITH_SHOCK_DEAL
  BUY_TO_GET_GIFT
}

enum GroupStatus {
  ACTIVE
  CHECK_OUT
  DELETED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}
